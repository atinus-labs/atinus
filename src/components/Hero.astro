---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { site } from '../config/site';
---

<section class="hero">
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="stage" aria-hidden="true">
    <img class="still" src="/attractor.webp" alt="" width="1600" height="1188" />
  </div>

  <header class="bar">
    <a class="brand reveal" href="/" aria-label="Atinus">
      <Logo size={26} />
      <span>atinus</span>
    </a>
    <a class="pill reveal" href={site.github} style="--delay: 0.1s">GitHub <Arrow /></a>
  </header>

  <div class="copy">
    <h1 class="reveal" style="--delay: 0.05s">We can’t leave a hard problem alone.</h1>
    <p class="reveal" style="--delay: 0.15s">
      Atinus is a group of developers who work through them together. Everything we make is open source.
    </p>
  </div>

  <figure class="readout reveal" aria-hidden="true" style="--delay: 0.25s">
    <code>x′ = sin(a·y) + c·cos(a·x)</code>
    <code>y′ = sin(b·x) + d·cos(b·y)</code>
    <code class="values" data-values>a −1.800  b  1.835  c −1.497  d −0.854</code>
  </figure>
</section>

<script>
  import { startAttractor, type Params } from '../scripts/attractor';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('.field')!;
  const stage = hero.querySelector<HTMLElement>('.stage')!;
  const values = hero.querySelector<HTMLElement>('[data-values]')!;

  const fmt = (v: number) => (v < 0 ? '−' : ' ') + Math.abs(v).toFixed(3);
  const show = ({ a, b, c, d }: Params) => {
    values.textContent = `a ${fmt(a)}  b ${fmt(b)}  c ${fmt(c)}  d ${fmt(d)}`;
  };

  if (startAttractor({ canvas, stage, onParams: show })) {
    hero.classList.add('live');
    canvas.addEventListener('attractor:failed', () => hero.classList.remove('live'));
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
  }

  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .stage {
    position: absolute;
    top: 9%;
    right: 2vw;
    width: 62vw;
    height: 78%;
    display: grid;
    place-items: center;
  }

  .still {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 1.2s ease;
  }

  .live .field {
    opacity: 1;
  }

  .live .still {
    opacity: 0;
  }

  .bar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px var(--pad);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand span {
    margin-top: -3px;
  }

  .copy {
    position: absolute;
    left: var(--pad);
    bottom: clamp(36px, 8vh, 80px);
    max-width: 32rem;
    pointer-events: none;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .copy p {
    max-width: 25rem;
    margin-top: 24px;
    color: var(--mute);
    font-size: 18px;
    text-wrap: pretty;
  }

  .readout {
    position: absolute;
    right: var(--pad);
    bottom: clamp(36px, 8vh, 80px);
    display: grid;
    justify-items: end;
    gap: 2px;
    color: var(--dim);
    font: 12.5px/1.6 var(--mono);
  }

  .readout code {
    font: inherit;
    white-space: pre;
  }

  .values {
    margin-top: 6px;
    color: var(--mute);
  }

  @media (max-width: 760px), (max-aspect-ratio: 1/1) {
    .stage {
      top: 10%;
      right: 3vw;
      width: 94vw;
      height: 42%;
    }

    .readout {
      top: calc(52% + 4px);
      bottom: auto;
      left: var(--pad);
      right: auto;
      justify-items: start;
      font-size: 11px;
    }

    .copy {
      right: var(--pad);
    }
  }
</style>
