---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { site } from '../config/site';
---

<section class="hero">
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="stage" aria-hidden="true">
    <div class="art">
      <img class="still" src="/attractor.webp" alt="" width="1600" height="1188" />
    </div>
  </div>

  <header class="bar">
    <a class="brand reveal" href="/" aria-label="Atinus">
      <Logo size={26} />
      <span>atinus</span>
    </a>
    <a class="pill reveal" href={site.github} style="--delay: 0.1s">GitHub <Arrow /></a>
  </header>

  <div class="copy">
    <h1 class="reveal" style="--delay: 0.05s">We can’t leave<br /> a hard problem<br /> alone.</h1>
    <p class="reveal" style="--delay: 0.15s">
      Atinus is a group of developers who work through them together. Everything we make is open source.
    </p>
  </div>

  <figure class="readout reveal" aria-hidden="true" style="--delay: 0.25s">
    <code>x′ = sin(a·y) + c·cos(a·x)</code>
    <code>y′ = sin(b·x) + d·cos(b·y)</code>
    <code class="values" data-values>a −1.800  b  1.835  c −1.497  d −0.854</code>
  </figure>
</section>

<script>
  import { startAttractor, type Params } from '../scripts/attractor';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('.field')!;
  const art = hero.querySelector<HTMLElement>('.art')!;
  const values = hero.querySelector<HTMLElement>('[data-values]')!;

  const fmt = (v: number) => (v < 0 ? '−' : ' ') + Math.abs(v).toFixed(3);
  const show = ({ a, b, c, d }: Params) => {
    values.textContent = `a ${fmt(a)}  b ${fmt(b)}  c ${fmt(c)}  d ${fmt(d)}`;
  };

  if (startAttractor({ canvas, stage: art, onParams: show })) {
    hero.classList.add('live');
    canvas.addEventListener('attractor:failed', () => hero.classList.remove('live'));
  }
</script>

<style>
  /* Phones and tall screens: the attractor on top, the words underneath.
     Wide screens (further down): the words at the left, the attractor at the right. */
  .hero {
    --end: max(clamp(1.5rem, 5svh, 3rem), calc(env(safe-area-inset-bottom, 0px) + 0.75rem));
    position: relative;
    display: grid;
    grid-template:
      'bar' auto
      'stage' minmax(min(60vw, 30svh), 1fr)
      'readout' auto
      'copy' auto
      / minmax(0, 1fr);
    /* On screens wider than about 2:1, frame the page in the middle. */
    --frame: max(0px, (100vw - 210svh) / 2);
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 calc(var(--pad-r) + var(--frame)) var(--end) calc(var(--pad-l) + var(--frame));
    overflow: hidden;
    overflow: clip;
  }

  .hero > * {
    position: relative;
  }

  .hero > .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  /* The space for the attractor. `.art` is the attractor's own box, as large
     as fits, a little below the middle so it sits close to its formula. */
  .stage {
    grid-area: stage;
    display: grid;
    grid-template-rows: 3fr auto 1fr;
    justify-items: center;
    margin-inline: calc(3vw - var(--pad));
    container-type: size;
    /* Drag the attractor on touch screens; pinching still zooms. */
    touch-action: pinch-zoom;
  }

  .art {
    grid-row: 2;
    width: min(100cqw, 100cqh * 1600 / 1188);
    aspect-ratio: 1600 / 1188;
  }

  .still {
    display: block;
    width: 100%;
    height: 100%;
    transition: opacity 1.2s ease;
  }

  .live .field {
    opacity: 1;
  }

  .live .still {
    opacity: 0;
  }

  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: calc(clamp(0.75rem, 2.6svh, 1.375rem) + env(safe-area-inset-top, 0px))
      clamp(0.75rem, 2.6svh, 1.375rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand :global(svg) {
    width: 1.08em;
    height: 1.08em;
  }

  .brand span {
    margin-top: -0.125em;
  }

  .copy {
    grid-area: copy;
    align-self: end;
    pointer-events: none;
  }

  h1 {
    font-size: clamp(2rem, min(10.5vw, 6svh), 7rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .copy p {
    max-width: 25rem;
    margin-top: clamp(0.75rem, 2.6svh, 1.5rem);
    color: var(--mute);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
    text-wrap: pretty;
  }

  .readout {
    grid-area: readout;
    display: grid;
    gap: 0.125rem;
    margin: 0.5rem 0 clamp(1.25rem, 4svh, 2.5rem);
    color: var(--dim);
    font: min(0.6875rem, 3.3vw) / 1.6 var(--mono);
  }

  .readout code {
    font: inherit;
    white-space: pre;
  }

  .values {
    margin-top: 0.375rem;
    color: var(--mute);
  }

  @media (min-aspect-ratio: 6/5) and (min-width: 540px) {
    .hero {
      --end: max(clamp(1.25rem, 8svh, 5rem), env(safe-area-inset-bottom, 0px));
      grid-template:
        'bar bar' auto
        'copy stage' minmax(0, 1fr)
        'copy readout' auto
        / fit-content(44vw) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }

    .stage {
      grid-template-rows: 1fr auto 1fr;
      margin-inline: 0 calc(2vw - var(--pad));
    }

    h1 {
      font-size: clamp(1.75rem, min(5.6vw, 8.9svh), 5rem);
    }

    .readout {
      justify-self: end;
      justify-items: end;
      margin: 0.75rem 0 0;
      font-size: 0.78rem;
    }
  }

  /* Phones on their side and short windows: give the attractor all the height. */
  @media (min-aspect-ratio: 6/5) and (min-width: 540px) and (max-height: 500px) {
    .stage {
      grid-row: stage / readout;
    }

    .readout {
      display: none;
    }
  }

  /* Watch-sized screens. */
  @media (max-width: 300px) {
    .brand {
      font-size: 1.25rem;
    }

    .bar .pill {
      height: 2.25rem;
      padding: 0 0.75rem;
    }
  }
</style>
