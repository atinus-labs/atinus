---
// The mark: a circle for the bowl and a stem that just touches it, as in the
// lowercase "a" of the wordmark. Coloured by `currentColor`.
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="-232 -232 464 464" aria-hidden="true">
  <circle r="200" fill="none" stroke="currentColor" stroke-width="64"></circle>
  <path d="M200 -200V200" fill="none" stroke="currentColor" stroke-width="64" stroke-linecap="round"></path>
</svg>
